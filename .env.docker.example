# ==========================================
# NEXERA PRODUCTION ENVIRONMENT CONFIGURATION
# Copy file này thành .env trên server: cp .env.docker.example .env
# ==========================================

# 1. SERVER IP / DOMAIN CONFIGURATION
# Tên miền chính thức của hệ thống Nexera
FRONTEND_URL=https://nexeragroup.vn

# Client Browser gọi vào Backend API:
NEXT_PUBLIC_BACKEND_URL=https://api.nexeragroup.vn

# 2. SUPABASE CONFIGURATION
# Lấy từ Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. PAYOS CONFIGURATION (Cổng thanh toán QR)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# 4. CLOUDINARY CONFIGURATION (Upload ảnh)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_preset
